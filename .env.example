# OpenAI API Key (required for orchestration)
OPENAI_API_KEY=your_openai_api_key_here

# Vibe Kanban integration (optional)
# Set to your local Vibe Kanban backend URL to enable real issue creation.
# Default backend port is 3003 when running `pnpm run dev` inside external/vibe-kanban.
# Without this variable the integration runs in mock mode (no HTTP requests are made).
# VIBE_KANBAN_URL=http://localhost:3003
# VIBE_KANBAN_ORG_ID=your-org-uuid

# Dispatch behavior
# MOCK_DISPATCH=false
# ORCHESTRATION_LOG_PATH=data/orchestration-logs.ndjson

# Hermes LLM (Gemini 1.5 Flash - free tier with fallback)
# Get keys from: https://aistudio.google.com/app/apikey
# Free tier: 50 requests/day per key
GEMINI_API_KEY_PRIMARY=your_primary_gemini_api_key
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key

# Obsidian Vault (optional - for saving Hermes insights)
# OBSIDIAN_VAULT_PATH=~/Obsidian/Agent-Control-Room

# Supabase (optional - falls back to local JSON files when not set)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
#
# Server-only alternative (not exposed to browser):
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
